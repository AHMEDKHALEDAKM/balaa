# Root is documentation; copy to apps/dashboard/.env.local for Next.js.
APP_MODE=demo
AUTH_PROVIDER=digital_egypt_mock
EMAIL_MODE=test
TEST_INBOX=preview@balaa.invalid
# Demo original images require authenticated access; local storage is ignored by git.
# APP_MODE=supabase selects the Supabase adapter; start database and Edge Functions first.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
ENABLE_MOCK_IDENTITY=false
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never NEXT_PUBLIC_ or EXPO_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Mobile: copy to apps/mobile/.env; use computer LAN IP on physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENABLE_DEMO_INPUT=true
